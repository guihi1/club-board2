<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title %></title>
</head>

<body>
  <h1>
    <%= locals.title %>
  </h1>

  <% if (locals.errors && locals.errors.length > 0) { %>
    <ul style="color: red;">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <% if (locals.title === "Sign Up" && !(locals.user)) { %>
    <form action="" method="POST">
      <div>
        <label for="first_name">First Name</label>
        <input 
          type="text" 
          id="first_name" 
          name="fname" 
          value="<%= locals.fname ? fname : '' %>" 
        >
      </div>
      <div>
        <label for="last_name">Last Name</label>
        <input 
          type="text" 
          id="last_name" 
          name="lname" 
          value="<%= locals.lname ? lname : '' %>" 
        >
      </div>
      <div>
        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          value="<%= locals.username ? username : '' %>" 
        >
      </div>
      <div>
        <label for="pw">Password</label>
        <input type="password" id="pw" name="password">
      </div>
      <div>
        <label for="confirm_password">Confirm Password</label>
        <input type="password" id="confirm_password" name="confirm_password">
      </div>
      <div>
        <label for="admin">Register as Admin</label>
        <input type="checkbox" id="admin" name="admin" <%= locals.admin ? 'checked' : '' %> >
      </div>
      <div>
        <label for="club_passcode">Club Passcode</label>
        <input 
          type="password" 
          id="club_passcode" 
          name="club_passcode" 
          value="<%= locals.club_passcode ? club_passcode : '' %>" 
        >
      </div>
      <button type="submit">Sign Up</button>
    </form>
  <% } else if (locals.title === "Sign In" && !(locals.user)) { %>
    <form action="" method="POST">
      <div>
        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          value="<%= locals.username ? username : '' %>" 
        >
      </div>
      <div>
        <label for="pw">Password</label>
        <input type="password" id="pw" name="password">
      </div>
      <button type="submit">Sign In</button>
    </form>
  <% } else { %>
    <h1>Hello, <%= locals.user.username %>.</h1>
    <h2>You're logged in</h2>
    <a href="/log-out">LOG OUT</a>
  <% } %>
</body>

</html>
