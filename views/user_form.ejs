<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= locals.title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container mt-5">
    <h1 class="text-center mb-4">
      <%= locals.title %>
    </h1>

    <% if (locals.errors && locals.errors.length> 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% locals.errors.forEach(error=> { %>
            <li>
              <%= error.msg %>
            </li>
            <% }) %>
        </ul>
      </div>
      <% } %>

        <% if (locals.title==="Sign Up" && !(locals.user)) { %>
          <form action="" method="POST" class="card p-4 shadow-sm bg-white">
            <div class="mb-3">
              <label for="first_name" class="form-label">First Name</label>
              <input type="text" id="first_name" name="fname" class="form-control"
                value="<%= locals.fname ? locals.fname : '' %>" required>
            </div>
            <div class="mb-3">
              <label for="last_name" class="form-label">Last Name</label>
              <input type="text" id="last_name" name="lname" class="form-control"
                value="<%= locals.lname ? locals.lname : '' %>" required>
            </div>
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input type="text" id="username" name="username" class="form-control"
                value="<%= locals.username ? locals.username : '' %>" required>
            </div>
            <div class="mb-3">
              <label for="pw" class="form-label">Password</label>
              <input type="password" id="pw" name="password" class="form-control" required>
            </div>
            <div class="mb-3">
              <label for="confirm_password" class="form-label">Confirm Password</label>
              <input type="password" id="confirm_password" name="confirm_password" class="form-control" required>
            </div>
            <div class="form-check mb-3">
              <input type="checkbox" id="admin" name="admin" class="form-check-input" <%=locals.admin ? 'checked' : ''
                %> >
              <label for="admin" class="form-check-label">Register as Admin</label>
            </div>
            <div class="mb-3">
              <label for="club_passcode" class="form-label">Club Passcode</label>
              <input type="password" id="club_passcode" name="club_passcode" class="form-control"
                value="<%= locals.club_passcode ? locals.club_passcode : '' %>" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign Up</button>
          </form>
          <% } else if (locals.title==="Sign In" && !(locals.user)) { %>
            <form action="" method="POST" class="card p-4 shadow-sm bg-white">
              <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" class="form-control"
                  value="<%= locals.username ? locals.username : '' %>" required>
              </div>
              <div class="mb-3">
                <label for="pw" class="form-label">Password</label>
                <input type="password" id="pw" name="password" class="form-control" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">Sign In</button>
            </form>
            <% } else { %>
              <div class="card p-4 shadow-sm bg-white text-center">
                <h1>Hello, <%= locals.user.username %>.</h1>
                <h2>You're logged in</h2>
                <a href="/log-out" class="btn btn-danger mt-3">LOG OUT</a>
              </div>
              <% } %>
  </div>
</body>

</html>
