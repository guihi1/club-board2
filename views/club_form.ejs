<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= locals.title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container mt-5">
    <% if (locals.user && locals.user.club) { %>
      <p class="alert alert-info">You're already a club member.</p>
      <a href="/posts" class="btn btn-primary">Back to Posts</a>
      <% } else { %>
        <h1>Join the Club</h1>
        <form action="/club" method="POST" class="card p-4 shadow-sm bg-white">
          <div class="mb-3">
            <label for="club_passcode" class="form-label">Enter Club Password:</label>
            <input type="password" id="club_passcode" name="club_passcode" class="form-control"
              placeholder="Club Password" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Join Club</button>
        </form>

        <% if (locals.error) { %>
          <div class="alert alert-danger mt-3">
            <%= locals.error %>
          </div>
          <% } %>
            <% } %>
  </div>
</body>

</html>
