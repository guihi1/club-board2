<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= locals.title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container mt-5">
    <h1>Hello, <%= locals.user ? locals.user.username : 'visitor' %>
    </h1>
    <% if (locals.posts.length==0) { %>
      <h2>No Posts to Show</h2>
      <% } else { %>
        <h2 class="mt-4">Posts</h2>
        <ul class="list-group">
          <% locals.posts.forEach(post=> { %>
            <li class="list-group-item mb-3 shadow-sm">
              <h3>
                <%= post.title %>
              </h3>
              <p>
                <%= post.body %>
              </p>
              <% if (locals.user && locals.user.club) { %>
                <p>
                  <%= post.username %>
                </p>
                <p>
                  <%= post.created_at %>
                </p>
                <% } else { %>
                  <p>Anonymous</p>
                  <p>Creation time: hidden</p>
                  <% } %>
                    <% if (locals.user && locals.user.admin) { %>
                      <form action="/posts/<%= post.id %>/delete" method="POST" class="mt-3">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                      </form>
                      <% } %>
            </li>
            <% }) %>
        </ul>
        <% } %>

          <% if (locals.user) { %>
            <a href="/posts/new" class="btn btn-primary mt-3">Write Post</a>
            <a href="/log-out" class="btn btn-secondary mt-3">Logout</a>
            <% if (!locals.user.club) { %>
              <a href="/club" class="btn btn-info mt-3">Join Club</a>
              <% } %>
                <% } else { %>
                  <a href="/sign-in" class="btn btn-primary mt-3">Login</a>
                  <a href="/sign-up" class="btn btn-secondary mt-3">Sign Up</a>
                  <% } %>
  </div>
</body>

</html>
